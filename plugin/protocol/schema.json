{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rotembab/jarvis-claude-mod/plugin/protocol/schema.json",
  "title": "Jarvis helper protocol v1",
  "description": "Messages between the Jarvis Claude Code mod and the jarvis-voice helper. Events: helper -> mod, one JSON object per stdout line. Commands: mod -> helper, HTTP POST /v1/<name> with a JSON body; responses are CommandResponse.",
  "$defs": {
    "v": { "const": 1 },
    "HelperState": { "enum": ["starting", "sleeping", "listening", "transcribing", "speaking", "awake", "error"] },
    "Platform": { "enum": ["windows", "macos", "linux"] },
    "ErrorCode": {
      "enum": [
        "already_running", "fish_key_missing", "fish_auth_failed", "fish_unreachable", "local_voice_failed",
        "mic_blocked", "mic_in_use", "no_input_device", "no_output_device",
        "stt_model_missing", "stt_failed", "ptt_unavailable", "wake_unavailable", "aec_unavailable",
        "bad_request", "unauthorized", "internal"
      ]
    },
    "UtteranceSource": { "enum": ["ptt", "command", "wake"] },
    "BargeInMode": { "enum": ["speech", "wake", "off"] },

    "HelloEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "port", "pid", "platform", "version", "capabilities"],
      "properties": {
        "v": { "$ref": "#/$defs/v" }, "type": { "const": "hello" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "pid": { "type": "integer" },
        "platform": { "$ref": "#/$defs/Platform" },
        "version": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "StateEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "state"],
      "properties": { "v": { "$ref": "#/$defs/v" }, "type": { "const": "state" }, "state": { "$ref": "#/$defs/HelperState" } }
    },
    "LevelEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "mic", "out"],
      "properties": {
        "v": { "$ref": "#/$defs/v" }, "type": { "const": "level" },
        "mic": { "type": "number", "minimum": 0, "maximum": 1 },
        "out": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "UtteranceEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "id", "text", "source", "durationMs"],
      "properties": {
        "v": { "$ref": "#/$defs/v" }, "type": { "const": "utterance" },
        "id": { "type": "string" }, "text": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/UtteranceSource" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "language": { "type": "string" },
        "startedAtMs": { "type": "integer", "minimum": 0, "description": "when the user began speaking (the push-to-talk press, or where the listener heard the voice begin), on the helper's own millisecond clock" },
        "overSpeech": { "type": "boolean", "description": "the clip began while Jarvis was audible: it cut him off" }
      }
    },
    "SpeechStartedEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "replyId"],
      "properties": { "v": { "$ref": "#/$defs/v" }, "type": { "const": "speech_started" }, "replyId": { "type": "string" } }
    },
    "SpeechDoneEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "replyId", "interrupted", "spokenText"],
      "properties": {
        "v": { "$ref": "#/$defs/v" }, "type": { "const": "speech_done" },
        "replyId": { "type": "string" }, "interrupted": { "type": "boolean" }, "spokenText": { "type": "string" },
        "endedAtMs": { "type": "integer", "minimum": 0, "description": "when the reply's speech ended (played out or stopped), on the helper's own millisecond clock" }
      }
    },
    "BargeInEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "spokenText"],
      "properties": {
        "v": { "$ref": "#/$defs/v" }, "type": { "const": "barge_in" },
        "replyId": { "type": "string" }, "spokenText": { "type": "string" }
      }
    },
    "ErrorEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "code", "message", "fatal"],
      "properties": {
        "v": { "$ref": "#/$defs/v" }, "type": { "const": "error" },
        "code": { "$ref": "#/$defs/ErrorCode" }, "message": { "type": "string" },
        "hint": { "type": "string" }, "fatal": { "type": "boolean" }
      }
    },
    "ReadyEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "sttModel", "sttDevice", "pttKey"],
      "properties": {
        "v": { "$ref": "#/$defs/v" }, "type": { "const": "ready" },
        "sttModel": { "type": "string" }, "sttDevice": { "enum": ["cuda", "cpu"] },
        "voiceId": { "type": "string" }, "pttKey": { "type": "string" },
        "wakePhrase": { "type": "string", "description": "present while the wake word is loaded and switched on: \"Hey Jarvis\", or \"Jarvis\" while plain \"Jarvis\" works too" },
        "bargeIn": { "$ref": "#/$defs/BargeInMode" }
      }
    },
    "Event": {
      "oneOf": [
        { "$ref": "#/$defs/HelloEvent" }, { "$ref": "#/$defs/StateEvent" }, { "$ref": "#/$defs/LevelEvent" },
        { "$ref": "#/$defs/UtteranceEvent" }, { "$ref": "#/$defs/SpeechStartedEvent" }, { "$ref": "#/$defs/SpeechDoneEvent" },
        { "$ref": "#/$defs/BargeInEvent" }, { "$ref": "#/$defs/ErrorEvent" }, { "$ref": "#/$defs/ReadyEvent" }
      ]
    },

    "HeartbeatCommand": { "type": "object", "additionalProperties": false, "properties": {} },
    "SpeakCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["replyId", "seq", "text", "final"],
      "properties": {
        "replyId": { "type": "string", "minLength": 1 },
        "seq": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "maxLength": 4000 },
        "final": { "type": "boolean" }
      }
    },
    "StopCommand": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string" } } },
    "ListenCommand": {
      "type": "object", "additionalProperties": false, "required": ["action"],
      "properties": { "action": { "enum": ["start", "stop"] } }
    },
    "DesktopCommand": {
      "type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {
        "action": { "enum": ["open", "focus", "media", "volume", "screenshot", "lock", "clipboard_read", "clipboard_write"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 400 },
        "key": { "enum": ["play_pause", "next", "previous", "stop"] },
        "level": { "type": "integer", "minimum": 0, "maximum": 100 },
        "change": { "enum": ["up", "down", "mute", "unmute"] },
        "text": { "type": "string", "maxLength": 20000 }
      }
    },
    "ConfigCommand": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "voiceId": { "type": "string" }, "pttKey": { "type": "string" },
        "sttModel": { "type": "string" }, "language": { "type": "string" },
        "wakeWord": { "type": "boolean" },
        "plainWake": { "type": "boolean", "description": "also wake on plain \"Jarvis\" at the start of an utterance (helpers with the wake.plain capability)" },
        "bargeIn": { "$ref": "#/$defs/BargeInMode" },
        "wakeThreshold": { "type": "number", "minimum": 0.05, "maximum": 0.95 }
      }
    },
    "StatusCommand": { "type": "object", "additionalProperties": false, "properties": {} },
    "TestVoiceCommand": { "type": "object", "additionalProperties": false, "properties": { "text": { "type": "string", "maxLength": 1000 } } },
    "ShutdownCommand": { "type": "object", "additionalProperties": false, "properties": {} },

    "CommandResponse": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "error": {
          "type": "object", "required": ["code", "message"],
          "properties": { "code": { "$ref": "#/$defs/ErrorCode" }, "message": { "type": "string" } }
        },
        "stopped": { "type": "boolean", "description": "stop: true when a reply was playing or queued" },
        "desktop": { "type": "object", "description": "desktop: { result: done|failed|refused|unsupported, text, path?, clipboard? }" },
        "dropped": { "type": "boolean", "description": "speak: the sentence was ignored (stopped or finished reply, duplicate seq)" },
        "replyId": { "type": "string", "description": "test_voice: the reply id its speech events carry" },
        "applied": { "type": "array", "items": { "type": "string" }, "description": "config: the fields that took effect" },
        "already": { "type": "boolean", "description": "listen: already in the requested state" }
      }
    },
    "StatusResponse": {
      "type": "object", "required": ["ok", "state", "version", "platform"],
      "properties": {
        "ok": { "const": true },
        "state": { "$ref": "#/$defs/HelperState" },
        "version": { "type": "string" },
        "platform": { "$ref": "#/$defs/Platform" },
        "sttModel": { "type": "string" }, "sttDevice": { "type": "string" },
        "inputDevice": { "type": "string" }, "outputDevice": { "type": "string" },
        "voiceId": { "type": "string" }, "pttKey": { "type": "string" },
        "fishKeySet": { "type": "boolean" }, "ttsEngine": { "enum": ["fish", "local"] },
        "wakeWord": { "type": "string", "description": "the wake phrase, while it is loaded and switched on" },
        "bargeIn": { "$ref": "#/$defs/BargeInMode" },
        "echoCancel": { "enum": ["on", "off", "loading", "unavailable"], "description": "echo cancelling of what the listener hears" }
      }
    }
  },
  "x-commands": {
    "heartbeat": "#/$defs/HeartbeatCommand",
    "speak": "#/$defs/SpeakCommand",
    "stop": "#/$defs/StopCommand",
    "listen": "#/$defs/ListenCommand",
    "config": "#/$defs/ConfigCommand",
    "status": "#/$defs/StatusCommand",
    "desktop": "#/$defs/DesktopCommand",
    "test_voice": "#/$defs/TestVoiceCommand",
    "shutdown": "#/$defs/ShutdownCommand"
  }
}
