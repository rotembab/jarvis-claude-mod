{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rotembab/jarvis-claude-mod/plugin/protocol/hands.schema.json",
  "title": "Jarvis hands protocol v1",
  "description": "Messages between the Jarvis Claude Code mod and the jarvis-hands helper. Events: helper -> mod, one JSON object per stdout line. Commands: mod -> helper, HTTP POST /v1/<name> with a JSON body; responses are CommandResponse.",
  "$defs": {
    "v": { "const": 1 },
    "HandsState": { "enum": ["starting", "idle", "active", "paused", "calibrating", "error"] },
    "Platform": { "enum": ["windows", "macos", "linux"] },
    "ErrorCode": {
      "enum": [
        "already_running", "unsupported_platform", "no_camera", "camera_blocked", "camera_in_use", "camera_lost",
        "model_missing", "tracker_failed", "input_blocked", "overlay_failed", "bad_request", "unauthorized", "internal"
      ]
    },
    "GestureName": {
      "enum": [
        "engage", "disengage", "click", "double_click", "right_click", "drag_start", "drag_end", "scroll_start",
        "grab", "release", "throw_left", "throw_right", "throw_up", "throw_down", "resize_start", "user_input"
      ]
    },
    "CalibrationStep": { "enum": ["top_left", "top_right", "bottom_right", "bottom_left", "done", "cancelled"] },
    "EngageMode": { "enum": ["palm", "always"] },
    "HandChoice": { "enum": ["right", "left", "any"] },
    "AnchorChoice": { "enum": ["knuckles", "index"] },
    "Display": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "x", "y", "width", "height", "primary", "virtual", "used"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "x": { "type": "integer" }, "y": { "type": "integer" },
        "width": { "type": "integer", "minimum": 0 }, "height": { "type": "integer", "minimum": 0 },
        "primary": { "type": "boolean" },
        "virtual": { "type": "boolean" },
        "used": { "type": "boolean", "description": "Whether hand control maps onto this display." }
      }
    },

    "HelloEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "port", "pid", "platform", "version", "capabilities"],
      "properties": {
        "v": { "$ref": "#/$defs/v" }, "type": { "const": "hello" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "pid": { "type": "integer" },
        "platform": { "$ref": "#/$defs/Platform" },
        "version": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "StateEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "state"],
      "properties": { "v": { "$ref": "#/$defs/v" }, "type": { "const": "state" }, "state": { "$ref": "#/$defs/HandsState" } }
    },
    "ReadyEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "camera", "width", "height", "fps", "displays"],
      "properties": {
        "v": { "$ref": "#/$defs/v" }, "type": { "const": "ready" },
        "camera": { "type": "string", "description": "The camera's name, or its index when the name is unknown." },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "minimum": 0 },
        "displays": { "type": "array", "items": { "$ref": "#/$defs/Display" } }
      }
    },
    "GestureEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "name"],
      "properties": { "v": { "$ref": "#/$defs/v" }, "type": { "const": "gesture" }, "name": { "$ref": "#/$defs/GestureName" } }
    },
    "CalibrationEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "step"],
      "properties": {
        "v": { "$ref": "#/$defs/v" }, "type": { "const": "calibration" },
        "step": { "$ref": "#/$defs/CalibrationStep" },
        "display": { "type": "string", "description": "The display (or span of displays) being calibrated." }
      }
    },
    "ErrorEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "code", "message", "fatal"],
      "properties": {
        "v": { "$ref": "#/$defs/v" }, "type": { "const": "error" },
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string" },
        "hint": { "type": "string" },
        "fatal": { "type": "boolean" }
      }
    },
    "Event": {
      "oneOf": [
        { "$ref": "#/$defs/HelloEvent" }, { "$ref": "#/$defs/StateEvent" }, { "$ref": "#/$defs/ReadyEvent" },
        { "$ref": "#/$defs/GestureEvent" }, { "$ref": "#/$defs/CalibrationEvent" }, { "$ref": "#/$defs/ErrorEvent" },
        { "$ref": "#/$defs/KeyboardEvent" }
      ]
    },

    "EmptyCommand": { "type": "object", "additionalProperties": false, "properties": {} },
    "ConfigCommand": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "engage": { "$ref": "#/$defs/EngageMode" },
        "displays": {
          "oneOf": [
            { "const": "all" },
            { "type": "array", "items": { "type": "integer", "minimum": 1 } }
          ]
        },
        "hand": { "$ref": "#/$defs/HandChoice" },
        "anchor": { "$ref": "#/$defs/AnchorChoice" },
        "overlay": { "type": "boolean" },
        "cursorSpeed": { "type": "number", "minimum": 0.7, "maximum": 3, "description": "Gain on the cursor around the centre of the target region; the hand travel that crosses the screen is divided by it. Default 1." },
        "smoothing": { "type": "number", "minimum": 0.2, "maximum": 3, "description": "Steadiness against lag: higher is steadier at rest and lags more. Default 1." },
        "pinch": { "type": "number", "minimum": 0.85, "maximum": 1.15, "description": "How close thumb and finger must be for a pinch click; higher counts a looser pinch. Default 1." },
        "fist": { "type": "number", "minimum": 0.9, "maximum": 1.1, "description": "How tightly the fingers must curl for a fist (a grab); higher counts a looser fist. Default 1." },
        "engageSeconds": { "type": "number", "minimum": 0.1, "maximum": 2, "description": "Seconds an open palm is held still to take the cursor. Default 0.5." },
        "dragDistance": { "type": "number", "minimum": 0.7, "maximum": 4, "description": "How far the hand may drift during a pinch before it becomes a drag; higher is steadier clicks and a later drag. Default 1." },
        "flingSensitivity": { "type": "number", "minimum": 0.5, "maximum": 2.5, "description": "How light a flick throws a grabbed window; higher is a lighter flick. Default 1." },
        "scrollSpeed": { "type": "number", "minimum": 0.1, "maximum": 10, "description": "Multiplier on the scroll distance per pixel of hand motion (2.4 wheel units per pixel at 1). Default 1." },
        "deadZone": { "type": "number", "minimum": 0, "maximum": 8, "description": "Pixels the filtered cursor must move before it follows; higher is steadier at rest and coarser. Default 1." }
      }
    },
    "CalibrateCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["action"],
      "properties": { "action": { "enum": ["start", "cancel"] } }
    },

    "KeyboardState": { "enum": ["open", "practice", "closed"] },
    "KeyboardPhase": { "enum": ["placing", "warmup", "typing"] },
    "KeyboardPress": { "enum": ["pinch", "air", "windows"] },
    "KeyboardLevel": { "enum": ["ok", "degraded", "off"] },
    "KeyboardCommit": { "enum": ["review", "direct"] },
    "KeyboardLang": { "enum": ["en", "he"] },
    "KeyboardHold": { "enum": ["blocked", "password", "covered", "overlay", "focus", "yield", "slow"] },
    "KeyboardCloseReason": {
      "enum": [
        "command", "close_key", "fists", "idle", "paused", "desktop_locked", "runaway", "no_overlay", "camera",
        "disabled", "error", "input_blocked", "air_unreliable"
      ]
    },
    "ReviewState": { "enum": ["composing", "inserting", "aborted"] },
    "InsertAbort": { "enum": ["blocked", "password", "covered", "overlay", "focus", "yield", "stopped", "timeout", "failed"] },
    "KeyboardInsert": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "outcome", "sent", "of"],
      "properties": {
        "kind": { "enum": ["text", "enter"] },
        "outcome": { "enum": ["done", "aborted"] },
        "sent": { "type": "integer", "minimum": 0, "maximum": 200 },
        "of": { "type": "integer", "minimum": 1, "maximum": 200 },
        "reason": { "$ref": "#/$defs/InsertAbort" }
      }
    },
    "KeyboardReview": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "chars"],
      "properties": {
        "state": { "$ref": "#/$defs/ReviewState" },
        "chars": { "type": "integer", "minimum": 0, "maximum": 200, "description": "How many characters the review box holds, never which." },
        "insert": { "$ref": "#/$defs/KeyboardInsert" }
      }
    },
    "KeyboardReviewStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "chars"],
      "properties": {
        "state": { "$ref": "#/$defs/ReviewState" },
        "chars": { "type": "integer", "minimum": 0, "maximum": 200 }
      }
    },
    "KeyboardPractice": {
      "type": "object", "additionalProperties": false,
      "required": ["hitRate", "phantomsPerMin"],
      "properties": {
        "hitRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "phantomsPerMin": { "type": "number", "minimum": 0 },
        "recallIM": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "KeyboardSettings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "press": { "$ref": "#/$defs/KeyboardPress" },
        "commit": { "$ref": "#/$defs/KeyboardCommit" },
        "layout": { "enum": ["auto", "en", "he"] },
        "size": { "type": "number", "minimum": 0.6, "maximum": 1.6 },
        "reach": { "type": "number", "minimum": 0.8, "maximum": 1.5 },
        "dock": { "enum": ["top", "bottom"] },
        "idleS": { "type": "integer", "minimum": 5, "maximum": 300 },
        "inject": { "enum": ["unicode", "vk"] },
        "enter": { "enum": ["twice", "off"] }
      }
    },
    "KeyboardStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "state", "practiced"],
      "properties": {
        "enabled": { "type": "boolean" },
        "state": { "$ref": "#/$defs/KeyboardState" },
        "phase": { "$ref": "#/$defs/KeyboardPhase" },
        "press": { "$ref": "#/$defs/KeyboardPress" },
        "level": { "$ref": "#/$defs/KeyboardLevel" },
        "airFps": { "type": "number", "minimum": 0 },
        "airNoise": { "type": "number", "minimum": 0 },
        "commit": { "$ref": "#/$defs/KeyboardCommit" },
        "lang": { "$ref": "#/$defs/KeyboardLang" },
        "hold": { "$ref": "#/$defs/KeyboardHold" },
        "private": { "type": "boolean" },
        "practiced": { "type": "boolean" },
        "phantomsPerMin": { "type": "number", "minimum": 0 },
        "review": { "$ref": "#/$defs/KeyboardReviewStatus" }
      }
    },
    "KeyboardEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "state"],
      "properties": {
        "v": { "$ref": "#/$defs/v" }, "type": { "const": "keyboard" },
        "state": { "$ref": "#/$defs/KeyboardState" },
        "phase": { "$ref": "#/$defs/KeyboardPhase" },
        "reason": { "$ref": "#/$defs/KeyboardCloseReason" },
        "hold": { "$ref": "#/$defs/KeyboardHold" },
        "lang": { "$ref": "#/$defs/KeyboardLang" },
        "press": { "$ref": "#/$defs/KeyboardPress" },
        "level": { "$ref": "#/$defs/KeyboardLevel" },
        "commit": { "$ref": "#/$defs/KeyboardCommit" },
        "private": { "type": "boolean" },
        "review": { "$ref": "#/$defs/KeyboardReview" },
        "discarded": { "type": "integer", "minimum": 0, "maximum": 200 },
        "practice": { "$ref": "#/$defs/KeyboardPractice" }
      }
    },
    "KeyboardCommand": {
      "description": "Open, close and set the air keyboard. There is no action that inserts, sends or clears text, and no field that carries any.",
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["action"],
          "properties": { "action": { "enum": ["start", "practice", "stop", "recenter", "private", "public"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["action", "settings"],
          "properties": { "action": { "const": "configure" }, "settings": { "$ref": "#/$defs/KeyboardSettings" } }
        }
      ]
    },

    "Commands": {
      "description": "Command name -> body schema.",
      "type": "object",
      "properties": {
        "heartbeat": { "$ref": "#/$defs/EmptyCommand" },
        "status": { "$ref": "#/$defs/EmptyCommand" },
        "config": { "$ref": "#/$defs/ConfigCommand" },
        "pause": { "$ref": "#/$defs/EmptyCommand" },
        "resume": { "$ref": "#/$defs/EmptyCommand" },
        "engage": { "$ref": "#/$defs/EmptyCommand" },
        "disengage": { "$ref": "#/$defs/EmptyCommand" },
        "calibrate": { "$ref": "#/$defs/CalibrateCommand" },
        "shutdown": { "$ref": "#/$defs/EmptyCommand" },
        "keyboard": { "$ref": "#/$defs/KeyboardCommand" }
      }
    },

    "StatusResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "state", "version", "platform", "engaged", "fps", "inferMs", "displays", "settings"],
      "properties": {
        "ok": { "const": true },
        "state": { "$ref": "#/$defs/HandsState" },
        "version": { "type": "string" },
        "platform": { "$ref": "#/$defs/Platform" },
        "camera": { "type": "string" },
        "engaged": { "type": "boolean" },
        "fps": { "type": "number", "minimum": 0, "description": "Frames tracked per second, last few seconds." },
        "inferMs": { "type": "number", "minimum": 0, "description": "Mean hand-landmark time per frame." },
        "displays": { "type": "array", "items": { "$ref": "#/$defs/Display" } },
        "calibrated": { "type": "boolean" },
        "settings": {
          "type": "object", "additionalProperties": false,
          "required": [
            "engage", "hand", "anchor", "overlay", "cursorSpeed", "smoothing", "pinch", "fist", "engageSeconds",
            "dragDistance", "flingSensitivity", "scrollSpeed", "deadZone"
          ],
          "properties": {
            "engage": { "$ref": "#/$defs/EngageMode" },
            "hand": { "$ref": "#/$defs/HandChoice" },
            "anchor": { "$ref": "#/$defs/AnchorChoice" },
            "overlay": { "type": "boolean" },
            "cursorSpeed": { "type": "number" },
            "smoothing": { "type": "number" },
            "pinch": { "type": "number" },
            "fist": { "type": "number" },
            "engageSeconds": { "type": "number" },
            "dragDistance": { "type": "number" },
            "flingSensitivity": { "type": "number" },
            "scrollSpeed": { "type": "number" },
            "deadZone": { "type": "number" }
          }
        },
        "keyboard": { "$ref": "#/$defs/KeyboardStatus" }
      }
    },
    "OkResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["ok"],
      "properties": {
        "ok": { "const": true },
        "pending": {
          "const": true,
          "description": "pause / resume only: the camera change is still going on (the camera takes longer to open or close than the helper waits), so the state the command asks for is not reached yet."
        }
      }
    },
    "ErrorResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object", "additionalProperties": false,
          "required": ["code", "message"],
          "properties": { "code": { "$ref": "#/$defs/ErrorCode" }, "message": { "type": "string" } }
        }
      }
    },
    "CommandResponse": {
      "oneOf": [{ "$ref": "#/$defs/StatusResponse" }, { "$ref": "#/$defs/OkResponse" }, { "$ref": "#/$defs/ErrorResponse" }]
    }
  }
}
